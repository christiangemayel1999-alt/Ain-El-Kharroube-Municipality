generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CASE_WORKER
  FINANCE
  VIEWER
  POLICE
}

enum LocationUpdateSource {
  BROWSER_GEOLOCATION
  SHARE_LINK
  MANUAL_OVERRIDE
}

enum LocationSessionSource {
  AUTHENTICATED_USER
  SHARE_TOKEN
}

enum HousingType {
  RENTAL
  HOST
  SHELTER
  OTHER
}

enum HouseholdStatus {
  ACTIVE
  MOVED_OUT
  CLOSED
}

enum FamilyCheckStatus {
  PENDING
  CHECKED_SAFE
}

enum CasePriority {
  LOW
  MEDIUM
  HIGH
}

enum HousingUnitStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum RentalAgreementStatus {
  ACTIVE
  ENDED
  TERMINATED
}

enum IncidentType {
  MEDICAL
  HOUSING
  UTILITY
  PROTECTION
  OTHER
}

enum IncidentPriority {
  LOW
  MEDIUM
  HIGH
}

enum IncidentStatus {
  DRAFT
  REPORTED
  ACTIVE_RESPONSE
  CONTAINED
  RESOLVED
  CLOSED
  CANCELLED
  // Legacy values kept for backward compatibility with old records.
  OPEN
  IN_PROGRESS
}

enum EmergencyPlanType {
  SUSPICIOUS_VEHICLE
  SUSPICIOUS_PERSON
  ARMED_THREAT
  MEDICAL_EMERGENCY
  VILLAGE_LOCKDOWN
  CUSTOM
}

enum EmergencySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum UnitType {
  POLICE
  CHECKPOINT
  MEDICAL
}

enum UnitStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

enum DispatchStatus {
  NOTIFIED
  ACKNOWLEDGED
  EN_ROUTE
  ARRIVED
  INVESTIGATING
  COMPLETED
  UNAVAILABLE
}

enum IncidentTimelineEventType {
  INCIDENT_CREATED
  VEHICLE_UPDATED
  PLAN_ACTIVATED
  NOTIFICATIONS_SENT
  OFFICER_ACKNOWLEDGED
  UNIT_EN_ROUTE
  UNIT_ARRIVED
  CHECKPOINT_ACTIVATED
  MEDICAL_SUPPORT_REQUESTED
  INCIDENT_RESOLVED
  INCIDENT_CLOSED
  DISPATCH_STATUS_CHANGED
  NOTE_ADDED
}

enum MapReferenceType {
  ROAD
  IMPORTANT_BUILDING
  MUNICIPALITY_POINT
  CHECKPOINT
  SCHOOL
  CHURCH_MOSQUE
  SHELTER
  WATER_POINT
  LANDMARK
  CUSTOM
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  fullName     String
  role         Role
  isActive     Boolean     @default(true)
  liveLocationEnabled Boolean @default(false)
  liveLocationVisible Boolean @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  incidentsAssigned Incident[] @relation("IncidentAssignedUser")
  dispatches        IncidentDispatch[] @relation("IncidentDispatchOfficer")
  assignedUnits     ResponseUnit[] @relation("ResponseUnitAssignedOfficer")
  timelineEvents    IncidentTimeline[] @relation("IncidentTimelineCreatedBy")
  auditLogs         AuditLog[]
  emergencyPlans    EmergencyPlan[] @relation("EmergencyPlanCreatedBy")
  notifications     Notification[]
  trustedDevice     UserTrustedDevice? @relation("UserTrustedDeviceForUser")
  trustedDeviceResets UserTrustedDevice[] @relation("UserTrustedDeviceResetBy")
  liveLocationState LiveLocationState?
  liveLocationPoints LocationPoint[]
  locationSharingSessions LocationSharingSession[]
  locationShareTokens LocationShareToken[] @relation("LocationShareTokenForUser")
  createdLocationShareTokens LocationShareToken[] @relation("LocationShareTokenCreatedBy")
}

model UserTrustedDevice {
  id               String   @id @default(uuid())
  userId           String   @unique
  persistentIdHash String
  fingerprintHash  String
  deviceLabel      String?
  userAgent        String?
  platform         String?
  browserLanguage  String?
  timezone         String?
  screen           String?
  firstTrustedAt   DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  resetAt          DateTime?
  resetByUserId    String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user      User                   @relation("UserTrustedDeviceForUser", fields: [userId], references: [id], onDelete: Cascade)
  resetBy   User?                  @relation("UserTrustedDeviceResetBy", fields: [resetByUserId], references: [id], onDelete: SetNull)
  sessions  LocationSharingSession[]

  @@index([isActive, lastSeenAt])
  @@index([persistentIdHash])
}

model LiveLocationState {
  userId           String   @id
  isSharing        Boolean  @default(false)
  lastLatitude     Float?
  lastLongitude    Float?
  lastAccuracyM    Float?
  lastRecordedAt   DateTime?
  lastReceivedAt   DateTime?
  lastSource       LocationUpdateSource?
  lastBatteryLevel Int?
  lastPointId      String?
  updatedAt        DateTime @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastPoint LocationPoint? @relation("LastLiveLocationPoint", fields: [lastPointId], references: [id], onDelete: SetNull)

  @@index([isSharing, lastReceivedAt])
  @@index([lastReceivedAt])
}

model LocationSharingSession {
  id            String                @id @default(uuid())
  userId        String
  source        LocationSessionSource
  startedAt     DateTime              @default(now())
  stoppedAt     DateTime?
  isActive      Boolean               @default(true)
  stoppedReason String?
  tokenId       String?
  trustedDeviceId String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  token  LocationShareToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  trustedDevice UserTrustedDevice? @relation(fields: [trustedDeviceId], references: [id], onDelete: SetNull)
  points LocationPoint[]

  @@index([userId, isActive])
  @@index([startedAt])
  @@index([trustedDeviceId, isActive])
}

model LocationShareToken {
  id              String    @id @default(uuid())
  userId          String
  tokenHash       String    @unique
  label           String?
  expiresAt       DateTime
  revokedAt       DateTime?
  lastUsedAt      DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user      User                   @relation("LocationShareTokenForUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User?                  @relation("LocationShareTokenCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  sessions  LocationSharingSession[]
  points    LocationPoint[]

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@index([revokedAt])
}

model LocationPoint {
  id                String               @id @default(uuid())
  userId            String
  sessionId         String?
  tokenId           String?
  latitude          Float
  longitude         Float
  accuracyM         Float
  recordedAt        DateTime
  receivedAt        DateTime             @default(now())
  source            LocationUpdateSource
  batteryLevel      Int?
  isSharingSnapshot Boolean              @default(true)
  createdAt         DateTime             @default(now())

  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  session            LocationSharingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  token              LocationShareToken?     @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  liveLocationStates LiveLocationState[]     @relation("LastLiveLocationPoint")

  @@index([userId, receivedAt])
  @@index([userId, recordedAt])
  @@index([receivedAt])
  @@index([sessionId, receivedAt])
}

model Zone {
  id        String      @id @default(uuid())
  code      String      @unique
  name      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  households  Household[]
  housingUnits HousingUnit[]
}

model Household {
  id                 String          @id @default(uuid())
  householdCode      String          @unique
  firstName          String?
  lastName           String?
  fatherName         String?
  motherName         String?
  civilIdentityNumber String?        @unique
  phoneNumber        String?
  pinLabel           String?
  headName           String?
  arrivalDate        DateTime
  originArea         String?
  zoneId             String
  housingType        HousingType
  familySize         Int
  status             HouseholdStatus
  age0_4             Int             @default(0)
  age5_17            Int             @default(0)
  age18_59           Int             @default(0)
  age60plus          Int             @default(0)
  vulnerabilityFlags Json            @default("[]")
  needs              Json            @default("[]")
  notes              String?
  members            Json            @default("[]")
  safetyCheckStatus  FamilyCheckStatus @default(PENDING)
  casePriority       CasePriority      @default(MEDIUM)
  nationality        String?
  preferredLanguage  String?
  emergencyName      String?
  emergencyPhone     String?
  emergencyRelation  String?
  checkedByUserId    String?
  checkedAt          DateTime?
  hasCar             Boolean         @default(false)
  carModel           String?
  carColor           String?
  carPlate           String?
  isVerified         Boolean         @default(false)
  approxLat          Float?
  approxLng          Float?
  pinPrecisionM      Int             @default(500)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  zone             Zone              @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  contact          HouseholdContact?
  rentalAgreements RentalAgreement[]
  incidents        Incident[]
}

model HouseholdContact {
  id          String    @id @default(uuid())
  householdId String    @unique
  phone       String?
  whatsapp    String?
  consent     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model HousingUnit {
  id          String            @id @default(uuid())
  unitCode    String            @unique
  zoneId      String
  streetLabel String?
  type        String
  rooms       Int
  capacity    Int
  utilities   Json              @default("{}")
  condition   String
  status      HousingUnitStatus
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  zone             Zone              @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  rentalAgreements RentalAgreement[]
}

model Landlord {
  id        String    @id @default(uuid())
  name      String
  phone     String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  rentalAgreements RentalAgreement[]
}

model RentalAgreement {
  id             String                @id @default(uuid())
  agreementCode  String                @unique
  householdId    String
  housingUnitId  String
  landlordId     String
  startDate      DateTime
  endDate        DateTime?
  monthlyRent    Decimal               @db.Decimal(10, 2)
  deposit        Decimal?              @db.Decimal(10, 2)
  status         RentalAgreementStatus
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  household  Household @relation(fields: [householdId], references: [id], onDelete: Restrict)
  housingUnit HousingUnit @relation(fields: [housingUnitId], references: [id], onDelete: Restrict)
  landlord   Landlord @relation(fields: [landlordId], references: [id], onDelete: Restrict)
}

model Incident {
  id              String           @id @default(uuid())
  incidentCode    String           @unique
  title           String?
  householdId     String?
  type            IncidentType
  priority        IncidentPriority
  severity        EmergencySeverity @default(MEDIUM)
  description     String
  assignedUserId  String?
  emergencyPlanId String?
  locationLabel   String?
  locationLat     Float?
  locationLng     Float?
  locationAccuracyM Float?
  status          IncidentStatus
  dueDate         DateTime?
  activatedAt     DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  resolutionNotes String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  household      Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)
  assignedUser   User?      @relation("IncidentAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  emergencyPlan  EmergencyPlan? @relation("IncidentEmergencyPlan", fields: [emergencyPlanId], references: [id], onDelete: SetNull)
  vehicle        IncidentVehicle?
  dispatches     IncidentDispatch[]
  timeline       IncidentTimeline[]
  notifications  Notification[]

  @@index([status, priority, createdAt])
  @@index([emergencyPlanId])
}

model IncidentVehicle {
  id                  String   @id @default(uuid())
  incidentId          String   @unique
  vehicleType         String?
  brand               String?
  model               String?
  color               String?
  plateNumber         String?
  registrationCountry String?
  directionOfTravel   String?
  passengerCount      Int?
  notes               String?
  photoUrl            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

model ResponseUnit {
  id                String     @id @default(uuid())
  name              String
  type              UnitType
  status            UnitStatus @default(AVAILABLE)
  latitude          Float?
  longitude         Float?
  assignedOfficerId String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  assignedOfficer User? @relation("ResponseUnitAssignedOfficer", fields: [assignedOfficerId], references: [id], onDelete: SetNull)
  dispatches      IncidentDispatch[]

  @@index([type, status])
}

model IncidentDispatch {
  id             String         @id @default(uuid())
  incidentId     String
  unitId         String
  officerId      String?
  status         DispatchStatus @default(NOTIFIED)
  notifiedAt     DateTime?
  acknowledgedAt DateTime?
  enRouteAt      DateTime?
  arrivedAt      DateTime?
  completedAt    DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  incident      Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  unit          ResponseUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  officer       User? @relation("IncidentDispatchOfficer", fields: [officerId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([incidentId, status])
  @@index([officerId, status])
}

model IncidentTimeline {
  id          String                    @id @default(uuid())
  incidentId  String
  eventType   IncidentTimelineEventType
  message     String
  metadata    Json?
  createdById String?
  createdAt   DateTime                  @default(now())

  incident  Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("IncidentTimelineCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String
  timestamp DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model EmergencyPlan {
  id              String                 @id @default(uuid())
  name            String
  type            EmergencyPlanType      @default(CUSTOM)
  severity        EmergencySeverity      @default(MEDIUM)
  description     String?
  defaultNotificationTitle   String?
  defaultNotificationMessage String?
  isActive        Boolean                @default(false)
  createdByUserId String
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  createdBy    User                    @relation("EmergencyPlanCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  roadClosures EmergencyRoadClosure[]
  policePosts  EmergencyPolicePost[]
  steps        EmergencyPlanStep[]
  incidents    Incident[] @relation("IncidentEmergencyPlan")

  @@index([type, severity, isActive])
}

model EmergencyPlanStep {
  id               String            @id @default(uuid())
  planId           String
  stepOrder        Int
  title            String
  description      String?
  icon             String?
  unitTypeRequired UnitType         @default(POLICE)
  isRequired       Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  plan EmergencyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, stepOrder])
  @@index([planId, isRequired, unitTypeRequired])
}

model EmergencyRoadClosure {
  id        String   @id @default(uuid())
  planId    String
  roadLabel String
  startLat  Float
  startLng  Float
  endLat    Float
  endLng    Float
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan EmergencyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model EmergencyPolicePost {
  id            String   @id @default(uuid())
  planId        String
  label         String
  lat           Float
  lng           Float
  officersCount Int      @default(1)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  plan EmergencyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model Notification {
  id              String    @id @default(uuid())
  userId          String
  title           String
  message         String
  isRead          Boolean   @default(false)
  incidentId      String?
  dispatchId      String?
  incidentType    IncidentType?
  incidentPriority IncidentPriority?
  incidentSeverity EmergencySeverity?
  locationLabel   String?
  vehicleSummary  String?
  actionRequired  String?
  metadata        Json?
  emergencyPlanId String?
  policePostLabel String?
  targetLat       Float?
  targetLng       Float?
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  incident Incident?        @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  dispatch IncidentDispatch? @relation(fields: [dispatchId], references: [id], onDelete: SetNull)

  @@index([userId, isRead, createdAt])
  @@index([incidentId, createdAt])
}

model MapReference {
  id          String           @id @default(uuid())
  name        String
  type        MapReferenceType
  description String?
  lat         Float
  lng         Float
  color       String?
  icon        String?
  visible     Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([type, visible])
  @@index([visible])
}

