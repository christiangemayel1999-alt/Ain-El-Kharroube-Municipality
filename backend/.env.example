# Server
PORT=4000
# Optional explicit frontend origins (comma-separated)
# Example: FRONTEND_ORIGIN=https://ain-kharroube.vercel.app,https://my-preview.vercel.app
FRONTEND_ORIGIN=http://localhost:4200
# Backward-compatible alias (optional)
CLIENT_ORIGIN=http://localhost:4200

# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ain_kharroube

# Security
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=8h

