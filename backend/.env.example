# Server
PORT=4000
# Optional explicit frontend origins (comma-separated)
# Example: FRONTEND_ORIGIN=https://ain-kharroube.vercel.app,https://my-preview.vercel.app
FRONTEND_ORIGIN=http://localhost:4200
# Backward-compatible alias (optional)
CLIENT_ORIGIN=http://localhost:4200

# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ain_kharroube

# Security
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=8h

# Optional web push
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=

# Live camera WebRTC ICE config (JSON array). Keep default STUN if omitted.
# Example:
# LIVE_CAMERA_ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:turn.yourdomain.com:3478?transport=udp","turn:turn.yourdomain.com:3478?transport=tcp"],"username":"turn-user","credential":"turn-password"}]
LIVE_CAMERA_ICE_SERVERS_JSON=
# Optional: "all" (default) or "relay" (force TURN relay for stricter NAT networks)
LIVE_CAMERA_ICE_TRANSPORT_POLICY=all

